S1_DB_USER=exchange
S1_DB_PASSWORD=exchange
S2_DB_USER=insights
S2_DB_PASSWORD=insights
JWT_SECRET=replace-with-at-least-32-random-characters
SERVICE_API_KEY=replace-me
# Gemini free-tier key for the nightly report; without it "Run report now" sends a "report failed" email
GEMINI_API_KEY=optional
REPORT_RECIPIENTS=admin@example.com
WEB_URL=http://localhost
MM_USERNAME=market-maker
MM_PASSWORD=bot-password
# SAFE or UNSAFE (the deliberately broken concurrency variants)
EXCHANGE_CONCURRENCY_MODE=SAFE
# true = the web app shows built-in demo data instead of calling S1/S2
VITE_MOCK_DATA=false
